  "cards": [
    {
      "dot": "emerald",
      "title": "Stripe Webhook, Reconciliation & 3-Layer Idempotency",
      "items": [
        "Checkout embeds userId, documentId, and per-document zohoDealId in Stripe metadata",
        "Webhook verifies raw body HMAC-SHA256 signature and payment_status === 'paid'",
        "Deduplicates via stripe_event_id, (user_id, document_id), and ZohoSyncLog === 'SUCCESS'"
      ]
    },
    {
      "dot": "amber",
      "title": "20 Clients, 28 Zoho CRM Deals & Outage Resilience",
      "items": [
        "db:setup auto-creates all 28 Deals in Zoho CRM (zohoapis.in) and links each Document.zohoDealId",
        "If Zoho fails, client document access stays PAID and ZohoSyncLog records PENDING",
        "Retry works from the Logs Sheet UI (POST /api/zoho/retry/:id) or CLI (npm run sync:zoho-retry)"
      ]
    },
    {
      "dot": "cyan",
      "title": "#2F5CEA Portal UI, Shadcn Sheets & Supabase RLS",
      "items": [
        "Sign-In view provides a searchable 20-client directory; single-doc accounts auto-expand on login",
        "Global Payment Loading Overlay + separate Shadcn Sheets for Logs and Demo Actions",
        "PostgreSQL RLS restricts purchases, zoho_sync_logs, and document_contents strictly to auth.uid()"
      ]
    }
