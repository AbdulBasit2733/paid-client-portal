  "cards": [
    {
      "dot": "emerald",
      "title": "Stripe Webhook & 3-Layer Idempotency",
      "items": [
        "Checkout embeds stable userId, documentId, and zohoDealId in Stripe metadata",
        "Webhook verifies raw body HMAC-SHA256 signature and payment_status === 'paid'",
        "Deduplicates on stripe_event_id, (user_id, document_id), and ZohoSyncLog === 'SUCCESS'"
      ]
    },
    {
      "dot": "amber",
      "title": "Zoho CRM OAuth 2.0 & Outage Resilience",
      "items": [
        "Purchase entitlement commits in PostgreSQL before calling Zoho CRM API v6",
        "If Zoho fails, client document access stays PAID and ZohoSyncLog records PENDING",
        "Retry available via Portal UI button (POST /api/zoho/retry/:id) or CLI (npm run sync:zoho-retry)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Direct Supabase Reads & Tenant Isolation",
      "items": [
        "Browser queries documents, purchases, zoho_sync_logs, and document_contents directly from Supabase",
        "PostgreSQL RLS restricts purchases and document_contents strictly to auth.uid()",
        "Browser roles have SELECT-only privileges; only backend Prisma/service_role can write entitlements"
      ]
    }
  ]
