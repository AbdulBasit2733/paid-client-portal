datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id               String     @id @db.Uuid // Matches Supabase auth.users.id
  email            String     @unique
  name             String
  zohoDealId       String     @map("zoho_deal_id") // Stable Zoho CRM Deal ID mapped to this client
  stripeCustomerId String?    @unique @map("stripe_customer_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  documents        Document[]
  purchases        Purchase[]

  @@map("users")
}

model Document {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String
  priceCents  Int              @default(499900) @map("price_cents") // Stored in paise (₹4,999.00 INR)
  ownerId     String?          @map("owner_id") @db.Uuid // Optional client-specific assignment
  createdAt   DateTime         @default(now()) @map("created_at")

  owner       User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  content     DocumentContent?
  purchases   Purchase[]

  @@map("documents")
}

model DocumentContent {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @unique @map("document_id") @db.Uuid
  bodyMarkdown String   @map("body_markdown")
  secretCode   String   @map("secret_code")
  fileUrl      String?  @map("file_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_contents")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  documentId            String         @map("document_id") @db.Uuid
  zohoDealId            String         @map("zoho_deal_id")
  stripeSessionId       String         @unique @map("stripe_session_id")
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  stripeEventId         String         @map("stripe_event_id")
  amountCents           Int            @map("amount_cents")
  currency              String         @default("inr")
  status                PurchaseStatus @default(PAID)
  grantedAt             DateTime       @default(now()) @map("granted_at")

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document              Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  zohoSync              ZohoSyncLog?

  @@unique([userId, documentId]) // Prevents duplicate entitlement per client & document
  @@map("purchases")
}

model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")
  sessionId     String?  @map("session_id")
  processed     Boolean  @default(true)
  payload       Json?
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}

model ZohoSyncLog {
  id          String     @id @default(uuid()) @db.Uuid
  purchaseId  String     @unique @map("purchase_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  zohoDealId  String     @map("zoho_deal_id")
  status      SyncStatus @default(PENDING)
  attempts    Int        @default(0)
  lastError   String?    @map("last_error")
  zohoPayload Json?      @map("zoho_payload")
  syncedAt    DateTime?  @map("synced_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("zoho_sync_logs")
}
