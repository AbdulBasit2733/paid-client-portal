{
  "name": "paid-client-portal-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for Paid Client Access Integration (Stripe Webhooks, Prisma, Supabase RLS, Zoho CRM OAuth2)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "tsx src/scripts/setupDbAndSeed.ts",
    "sync:zoho-retry": "tsx src/scripts/retryZohoSync.ts",
    "zoho:token": "tsx src/scripts/exchangeZohoToken.ts",
    "stripe:listen": "stripe listen --all-snapshot --forward-to localhost:4000/api/webhooks/stripe",
    "test:integration": "tsx src/scripts/verifyIntegration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.8.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
