# ==============================================================================
# Paid Client Access Portal — Server Environment Variables (server/.env)
# IMPORTANT: Stripe, Supabase Service Role, and Zoho CRM credentials MUST stay
# strictly on the server and are NEVER exposed to the browser!
# ==============================================================================

PORT="4000"
CLIENT_URL="http://localhost:5173"

# 1. Supabase PostgreSQL & Admin Credentials (from Supabase Dashboard -> Project Settings -> Database & API)
# Use the Transaction/Session Pooler or Direct URI for DATABASE_URL & DIRECT_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Stripe Test Mode Keys (from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Obtained from running `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# 3. Zoho CRM OAuth 2.0 Credentials (from https://api-console.zoho.com/ -> Self Client)
# Tip: Run `npm run zoho:token -- <GRANT_TOKEN>` in server/ to exchange a grant token for ZOHO_REFRESH_TOKEN
ZOHO_CLIENT_ID="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
ZOHO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ZOHO_REFRESH_TOKEN="1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Region-specific Zoho URLs (.com, .in, .eu, .com.au)
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_API_URL="https://www.zohoapis.com"
ZOHO_PAID_STAGE="Closed Won"

# Optional: Set to "true" to force Zoho CRM sync failures globally for testing Requirement 3
ZOHO_FORCE_FAIL="false"

# 4. Stable Zoho CRM Deal IDs mapped to the two seeded test clients
ZOHO_DEAL_ID_ALICE="615294000000491001"
ZOHO_DEAL_ID_BOB="615294000000491002"
